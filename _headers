# Cloudflare Pages _headers

# Images and other static assets: cache for 1 year (immutable).
# NOTE: file names are not fingerprinted, so if you replace an image keep the
# same name only if you also change the reference (e.g. add ?v=2).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Our own CSS and JS change often and are not fingerprinted:
# cache for 1 hour and always revalidate, so deploys show up quickly.
/assets/css/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, must-revalidate

# Fonts never change: cache aggressively (re-applies the long cache after the
# /assets/css/* rule above).
/assets/css/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — revalidate on each visit (so updates deploy instantly)
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/index-en.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Favicon
/favicon.png
  Cache-Control: public, max-age=86400
